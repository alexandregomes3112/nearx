# Stellar Wallet with Dinamo HSM Environment Variables
# Copy this file to .env and fill in your actual values

# HSM Authentication
HSM_USER_PIN=your_hsm_user_pin_here

# Stellar Network Configuration (optional overrides)
STELLAR_NETWORK=TESTNET
HORIZON_URL=https://horizon-testnet.stellar.org

# HSM Library Path (if different from config)
PKCS11_LIB_PATH=/usr/lib/libdinamo.so

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=stellar_wallet.log

# Security settings
REQUIRE_CONFIRMATION=true
AUDIT_LOGGING=true

# Development settings
DEBUG_MODE=false
VERBOSE_LOGGING=false